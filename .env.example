# Copy to .env, or run `npm run wallet` to create .env with a fresh testnet-only key.
# NEVER put a key that holds real funds here, and never paste a key into a chat or an issue.
DEPLOYER_PRIVATE_KEY=

# Everything below is optional. Public RPC endpoints are used by default.
# LASNA_RPC=https://lasna-rpc.rnk.dev/
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
# SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Where the books live, and which chains Till accepts payment on.
# HOME_CHAIN=baseSepolia
# PAY_CHAINS=baseSepolia,unichainSepolia,sepolia

# Gas money given to the contracts at deployment.
# TILL_FUND_REACT=2
# CALLBACK_FUND_ETH=0.0005
