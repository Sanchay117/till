{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon|og\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/demo/*.js": {
      "maxDuration": 30
    }
  }
}
